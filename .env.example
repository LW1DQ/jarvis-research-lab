# JARVIS Research Lab - Environment Template
# Copy to .env and fill in your values
# NEVER commit .env to git!

# Timezone
TZ=America/Argentina/Rio_Gallegos

# Research root directory
RESEARCH_ROOT=/home/diego/research-jarvis

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# LLM APIs (optional - for hybrid cloud strategy)
# Get free keys from respective providers
NEMOTRON_API_KEY=your_nemotron_key_here
GROQ_API_KEY=your_groq_key_here
TAVILY_API_KEY=your_tavily_key_here
OPENAI_API_KEY=your_openai_key_here

# MCP Server ports
RESEARCH_MCP_PORT=8001
NS3_MCP_PORT=8002
PYTHON_MCP_PORT=8003
PERSONAL_MCP_PORT=8004

# LDR (Local Deep Research)
KHOJ_PORT=42110
OPENHANDS_PORT=3000

# NS-3
NS3_HOME=/home/diego/ns-3.48
NS3_AI_PATH=/home/diego/ns-3.48/contrib/ai

# Python
PYTHONPATH=/home/diego/research-jarvis:/home/diego/ns-3.48/contrib/ai/model/gym-interface/py:/home/diego/ns-3.48/contrib/ai/model/gym-interface/py/ns3ai_gym_env/envs:/home/diego/ns-3.48/contrib/ai/python_utils

# Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=jarvis_memory

# LangFuse (observability)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=http://localhost:3000